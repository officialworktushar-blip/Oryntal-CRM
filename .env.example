# Supabase — copy this file to `.env` and fill in real values (never commit secrets)
NEXT_PUBLIC_SUPABASE_URL=your-project-url            # e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key          # project → Settings → API
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server-only; keep out of client code